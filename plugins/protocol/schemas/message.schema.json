{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semaps:ide:message:v1",
  "title": "SeMaps IDE message v1",
  "type": "object",
  "required": ["protocol", "version", "sessionId", "kind"],
  "properties": {
    "protocol": { "const": "semaps.ide" },
    "version": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["request", "response", "event"] },
    "id": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "pattern": "^[a-z][a-zA-Z]*\\.[a-z][a-zA-Z]*$" },
    "params": { "type": "object" },
    "result": { "type": "object" },
    "error": {
      "type": "object", "required": ["code", "message"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string" }, "data": {} },
      "additionalProperties": false
    },
    "origin": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "properties": { "kind": { "const": "request" } }, "required": ["id", "method"],
      "not": { "anyOf": [{ "required": ["requestId"] }, { "required": ["result"] }, { "required": ["error"] }] }
    },
    {
      "properties": { "kind": { "const": "response" } }, "required": ["requestId"],
      "oneOf": [{ "required": ["result"], "not": { "required": ["error"] } }, { "required": ["error"], "not": { "required": ["result"] } }],
      "not": { "anyOf": [{ "required": ["id"] }, { "required": ["method"] }, { "required": ["params"] }] }
    },
    {
      "properties": { "kind": { "const": "event" } }, "required": ["id", "method"],
      "not": { "anyOf": [{ "required": ["requestId"] }, { "required": ["result"] }, { "required": ["error"] }] }
    }
  ],
  "additionalProperties": false
}
