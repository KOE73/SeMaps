{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KOE73/SeMaps/schemas/extractor-facts.schema.json",
  "title": "SeMaps extractor facts",
  "description": "What semaps-extract-<lang> prints to stdout. Normative text: docs/EXTRACTOR.md §2.",
  "type": "object",
  "required": ["language", "root", "symbols", "edges"],
  "additionalProperties": false,
  "properties": {
    "language": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "root": { "type": "string", "minLength": 1 },
    "edgeKinds": {
      "type": "array",
      "items": { "enum": ["extends", "implements", "contains", "depends", "holds", "uses", "injects", "calls"] },
      "description": "explicit list of edge kinds that these facts cover; sync marks missing only for listed kinds. `calls` is ignored by sync (ADR_20260928-4 §4)"
    },
    "symbols": {
      "type": "array",
      "items": { "$ref": "#/$defs/symbol" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^\\S+$" },
    "symbol": {
      "type": "object",
      "required": ["id", "kind", "nativeKind", "name", "file"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["type", "interface", "function", "module", "value", "method"] },
        "nativeKind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "file": { "type": "string", "pattern": "^[^\\\\]+$", "description": "relative to root, forward slashes" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1, "description": "last line of the declaration named by file/line" },
        "spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/span" },
          "description": "printed only when the symbol has more than one declaration (C# partial, TypeScript merged declarations); sorted by (file, line)"
        },
        "visibility": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" }
        },
        "memberLines": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 },
          "description": "member name -> line, beside members so sync never copies it into entities.json; a member declared in another file than the symbol's file is left out"
        }
      }
    },
    "span": {
      "type": "object",
      "required": ["file", "line"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^[^\\\\]+$" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "member": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "visibility": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["extends", "implements", "contains", "depends", "holds", "uses", "calls", "constructs", "overrides"] },
        "via": { "$ref": "#/$defs/via" },
        "line": { "type": "integer", "minimum": 1, "description": "where the edge comes from: the member for holds/uses, the base list for extends/implements, the first call site for calls. Not for contains and depends" },
        "file": { "type": "string", "pattern": "^[^\\\\]+$", "description": "only when it differs from the file of the `from` symbol" },
        "lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "every place of a calls or constructs edge inside the method, sorted ascending; line is the first of them (ADR_20260928-4 §3)"
        }
      }
    },
    "via": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": { "type": "string", "minLength": 1, "description": "name of the member" },
        "memberKind": { "type": "string", "minLength": 1, "description": "field, property, event, indexer, parameter, return, constructor, self" },
        "modifiers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "public, private, readonly, static, etc."
        },
        "text": { "type": "string", "minLength": 1, "description": "the member type as written in code" },
        "path": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "path inside the member type to the target symbol: item, key, value, result, arg:n, element:n, etc."
        },
        "cardinality": { "type": "string", "enum": ["one", "optional", "many", "keyed"], "description": "how many objects the member holds" },
        "mutability": { "type": "string", "enum": ["mutable", "readonly"], "description": "can the collection contents be modified through this member" },
        "deferred": { "type": "boolean", "description": "true if the object comes later (Task, Lazy, Promise, Func, IObservable)" }
      }
    }
  }
}
